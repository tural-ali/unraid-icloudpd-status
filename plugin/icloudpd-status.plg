<FILE Name="/tmp/IcloudpdStatus.page.b64">
<INLINE>

</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -e
PLG=/boot/config/plugins/icloudpd-status
WEB=/usr/local/emhttp/plugins/icloudpd-status
mkdir -p "$PLG" "$WEB"
for file in status.php widget.php widget-poll.php IcloudpdStatus.page; do
  [ -f "/tmp/$file.b64" ] || { echo "ERROR: Missing /tmp/$file.b64"; exit 1; }
  base64 -d < "/tmp/$file.b64" > "$PLG/$file"
  chmod 600 "$PLG/$file"
  install -m 600 "$PLG/$file" "$WEB/$file"
  rm -f "/tmp/$file.b64"
done
rm -f /var/local/emhttp/icloudpd-status-cache.json
echo "icloudpd-status installed. The Dashboard tile discovers all iCloudPD containers automatically."
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
rm -rf /usr/local/emhttp/plugins/icloudpd-status
rm -f /var/local/emhttp/icloudpd-status-cache.json
echo "icloudpd-status removed. Persistent source files were kept on flash."
]]>
</INLINE>
</FILE>

</PLUGIN>
